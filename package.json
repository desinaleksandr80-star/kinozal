{
  "name": "kinozal",
  "productName": "Кинозал",
  "version": "1.0.1",
  "description": "Кинозал — смотрим фильмы и показываем экран вместе",
  "main": "main.js",
  "author": "Kinozal",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "peerjs": "1.5.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.kinozal.app",
    "productName": "Кинозал",
    "artifactName": "Kinozal.exe",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "index.html", "node_modules/peerjs/dist/peerjs.min.js", "package.json"],
    "win": { "target": "portable", "icon": "build/icon.png" },
    "portable": { "artifactName": "Kinozal.exe" }
  }
}
