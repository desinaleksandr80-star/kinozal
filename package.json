{
  "name": "kinozal",
  "productName": "Кинозал",
  "version": "1.15.3",
  "description": "Кинозал — мессенджер, видеозвонки и кино вместе",
  "main": "main.js",
  "author": "Kinozal",
  "license": "MIT",
  "repository": "github:desinaleksandr80-star/kinozal",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis --x64 --publish always",
    "android": "node scripts/build-www.js && npx cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "peerjs": "1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
    "electron": "45.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.kinozal.app",
    "productName": "Кинозал",
    "directories": {
      "app": ".",
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "messenger.js",
      "signal.js",
      "rawprev.js",
      "viewers.js",
      "music.js",
      "music-main.js",
      "music.css",
      "messenger.css",
      "theme.js",
      "theme.css",
      "build/icon.png",
      "package.json",
      "web.js",
      "android.js",
      "mobile.css",
      "craft.css",
      "vendor/**",
      "icons/**",
      "manifest.webmanifest"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Kinozal-Setup.exe",
      "shortcutName": "Кинозал",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "desinaleksandr80-star",
      "repo": "kinozal",
      "releaseType": "release"
    }
  }
}
