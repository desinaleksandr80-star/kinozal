{
  "name": "kinozal",
  "productName": "Кинозал",
  "version": "1.4.1",
  "description": "Кинозал — смотрим фильмы и показываем экран вместе",
  "main": "main.js",
  "author": "Kinozal",
  "license": "MIT",
  "repository": "github:desinaleksandr80-star/kinozal",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "peerjs": "1.5.4"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.kinozal.app",
    "productName": "Кинозал",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "messenger.js",
      "messenger.css",
      "theme.js",
      "theme.css",
      "build/icon.png",
      "package.json",
      "node_modules/peerjs/dist/peerjs.min.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Kinozal-Setup.exe",
      "shortcutName": "Кинозал",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "desinaleksandr80-star",
      "repo": "kinozal",
      "releaseType": "release"
    }
  }
}
